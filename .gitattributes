# Fins de ligne cohérentes entre Windows et Linux
* text=auto

# Scripts exécutés sous Linux ou dans les conteneurs : toujours LF
*.sh        text eol=lf
*.template  text eol=lf
*.env       text eol=lf
.env        text eol=lf
Dockerfile  text eol=lf

# Scripts PowerShell : CRLF
*.ps1       text eol=crlf

# Fichiers binaires
*.png  binary
*.jpg  binary
*.webp binary
*.tar  binary
